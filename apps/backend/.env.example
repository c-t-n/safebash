NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/safebash

# Auth – JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Explainer LLM — local Ollama daemon. Leave OLLAMA_URL empty to disable
# AI summaries and fall back to dictionary-only templated output.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# Job broker — script analysis runs on a separate worker process consuming
# from this queue. The API only publishes jobs; the worker (see
# `pnpm worker`) handles the actual LLM work.
RABBITMQ_URL=amqp://localhost:5672
ANALYSIS_QUEUE=safebash.analysis
