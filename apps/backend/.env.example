NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Database
MONGODB_URI=mongodb://localhost:27017/safebash

# Auth – JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Explainer LLM — local Ollama daemon. Leave OLLAMA_URL empty to disable
# AI summaries and fall back to dictionary-only templated output.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
